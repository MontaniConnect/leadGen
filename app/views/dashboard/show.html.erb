<main class="page">
<h1>Prefilter and pipeline</h1>
<p class="hint"><%= link_to "Import another file", new_import_path %></p>

<% running = @pipeline.running?("score") || @pipeline.running?("draft") %>
<% content_for(:head) { tag.meta("http-equiv": "refresh", content: "5") } if running %>

<section class="panel pipeline" aria-labelledby="pipeline-heading">
  <h2 id="pipeline-heading">Pipeline</h2>
  <ol class="steps">
    <li>
      <strong>1. Passed the filters:</strong> <%= @pipeline.passed %> companies
    </li>

    <li>
      <strong>2. Pages fetched:</strong> <%= @pipeline.fetched %> of <%= @pipeline.passed %>
      <% fetch_count = @pipeline.awaiting_fetch.count %>
      <%= button_to "Fetch pages for #{pluralize(fetch_count, 'company')} (free)", pipeline_fetch_path, method: :post,
            class: "btn secondary", disabled: fetch_count.zero?, form: { data: { turbo_submits_with: "Starting…" } } %>
    </li>

    <li>
      <strong>3. Contacts:</strong> <%= @contact_counts.fetch("selected", 0) %> found. See "Contacts" below to look for more.
    </li>

    <li>
      <strong>4. Scored:</strong>
      Hot <%= @pipeline.tiers["Hot"] %> · Warm <%= @pipeline.tiers["Warm"] %> · Cold <%= @pipeline.tiers["Cold"] %>
      <% if @pipeline.failed_evaluations.positive? %>· <%= @pipeline.failed_evaluations %> failed (will retry)<% end %>
      <% if @score_step.problem %>
        <p class="hint" role="status"><%= @score_step.problem %></p>
      <% else %>
        <% score = paid_button("Score", @score_step, "company") %>
        <%= button_to score[:label], pipeline_score_path, method: :post, class: "btn",
              form: { data: { turbo_confirm: score[:confirm], turbo_submits_with: "Starting…" } } %>
      <% end %>
      <% if (run = @pipeline.last_run("score")) %><p class="hint"><%= Budget::RunSummary.new(run) %></p><% end %>
    </li>

    <li>
      <strong>5. Messages drafted (Hot and Warm):</strong> <%= @pipeline.drafted %> companies
      <% if @draft_step.problem %>
        <p class="hint" role="status"><%= @draft_step.problem %></p>
      <% else %>
        <% draft = paid_button("Draft messages for", @draft_step, "lead") %>
        <%= button_to draft[:label], pipeline_draft_path, method: :post, class: "btn",
              form: { data: { turbo_confirm: draft[:confirm], turbo_submits_with: "Starting…" } } %>
      <% end %>
      <% if (run = @pipeline.last_run("draft")) %><p class="hint"><%= Budget::RunSummary.new(run) %></p><% end %>
    </li>
    <li>
      <strong>Partners (staffing firms):</strong> <%= Company.partner_candidates.count %> found,
      <%= Message.where(label: "partnership").select(:company_id).distinct.count %> with a message.
      <%= link_to "Open Partners", partners_path %>
    </li>
  </ol>
  <p><%= link_to "Review the scored leads and their messages →", root_path, class: "btn" %>
     <span class="hint">Spending: <%= link_to "Spend page", spend_path %></span></p>
</section>



<p>
  <%= link_to "Pass: #{@status_counts.fetch('pass', 0)}", dashboard_path(status: "pass") %> ·
  <%= link_to "Fail: #{@status_counts.fetch('fail', 0)}", dashboard_path(status: "fail") %> ·
  Pending: <%= @status_counts.fetch("pending", 0) %> ·
  <%= link_to "All", dashboard_path %>
</p>

<h2>Contacts (passed companies)</h2>
<p>
  Selected: <%= @contact_counts.fetch("selected", 0) %> ·
  Not found (about-page fallback queue): <%= @contact_counts.fetch("not_found", 0) %> ·
  Not yet selected: <%= @contact_counts.fetch("pending", 0) %>
</p>
<% if @checked_without_name.positive? %>
  <p class="hint"><%= @checked_without_name %> company websites were checked and showed no clearly named leader. Upload the Apollo People file, or add a contact yourself on the lead page.</p>
<% end %>
<%= button_to "Look for contacts on their websites (#{@lookup_count})", contact_research_path, method: :post,
      class: "btn secondary", disabled: @lookup_count.zero?,
      form: { data: { turbo_submits_with: "Starting…" } } %>
<p class="hint">Free: reads each company's own About page only. It never uses LinkedIn.</p>

<h2>Fail reasons</h2>
<% if @reason_counts.empty? %>
  <p>No failures yet. Run <code>bin/rails prefilter:run</code>.</p>
<% else %>
  <table>
    <thead><tr><th>Reason</th><th>Companies</th></tr></thead>
    <tbody>
      <% @reason_counts.each do |reason, count| %>
        <tr>
          <td><%= link_to reason, dashboard_path(status: "fail", reason: reason) %></td>
          <td><%= count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Companies (first <%= DashboardController::LIST_LIMIT %>)</h2>
<table>
  <thead><tr><th>Company</th><th>Website</th><th>Employees</th><th>Country</th><th>Result</th><th aria-sort="<%= aria_sort(@sort_dir) %>"><%= why_header(@sort_dir, list_filters) %></th><th>Contact</th><th>Scored</th></tr></thead>
  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.name %></td>
        <td><% if website_url(company) %><%= link_to website_label(company), website_url(company), target: "_blank", rel: "noopener noreferrer" %><% end %></td>
        <td><%= company.employees %></td>
        <td><%= company.country %></td>
        <td><%= company.prefilter_status.capitalize %></td>
        <td><%= (company.prefilter_status == "fail" ? company.prefilter_reasons : company.prefilter_boosts).join(", ") %></td>
        <td><%= contact_label(company) %></td>
        <td><%= scored_label(company) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "Back to leads", root_path %></p>
</main>
